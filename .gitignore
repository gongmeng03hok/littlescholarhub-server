# Dependencies and build output — reinstallable, and huge.
node_modules/
lsh.api/venv/
lsh.web/src/dist/
lsh.web/dist/
lsh.web/dist_candidate/
dist_old_*/
.expo/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Secrets. NEVER commit these — .env holds the live DB password, JWT secret
# and SMTP credentials. Templates only.
.env
*.env
!.env.example

# My timestamped safety copies; git is the history now.
*.bak
*.bak-*
*.bak2-*
*.pre-graft-*
*.pre-wisdom-*
src.bak.*
app.bak.*
assets.bak.*

# Logs and scratch
*.log
expo-log.txt
.DS_Store

# A full CREATE DATABASE dump, not a migration.
lsh.database/complete_bckp.sql

# A copy of the live .env — never commit.
.env.save
*.env.save
**/.env.save
**/.env.bak
**/.env.local
